# Copia este archivo como .env para personalizar valores (opcional).
# Credenciales solo para el PostgreSQL LOCAL de desarrollo; no son secretos reales.
POSTGRES_DB=medimatch
POSTGRES_USER=medimatch
POSTGRES_PASSWORD=medimatch_local
# Puerto de PostgreSQL en tu máquina (dentro de Docker siempre es 5432).
DB_HOST_PORT=5433

# Solo si ejecutas el backend fuera de Docker:
# DATABASE_URL=postgresql+psycopg://medimatch:medimatch_local@localhost:5433/medimatch
# MOCK_API_URL=http://localhost:8001
# SYNC_ON_STARTUP=true
